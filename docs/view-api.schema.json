        "pinned": {
          "title": "Pinned",
          "type": "boolean"
        },
        "protect_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Protect Reasons",
          "type": "array"
        },
        "protected": {
          "title": "Protected",
          "type": "boolean"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "surprise": {
          "title": "Surprise",
          "type": "number"
        },
        "suspect_since": {
          "title": "Suspect Since",
