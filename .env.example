# Copy to .env (git-ignored). Every variable Plexus reads is listed here.

# --- FalkorDB connection (used by plexus/ and tests) ---
# 127.0.0.1 avoids a ~2 s IPv6 (::1) fallback per connection on Windows + Docker Desktop.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
# Leave empty for no auth (local dev). Set when deploying publicly.
FALKORDB_PASSWORD=

# --- Tests (give each agent/suite its own container: scripts/agent_db.sh <slot>) ---
# Pass inline (PLEXUS_TEST_DB_PORT=6310 uv run pytest), do not export.
PLEXUS_TEST_DB_PORT=6310

# --- Code scan client (`plexus code scan | baseline | hook-run`, docs/staleness.md) ---
# Tenant the code hooks report to (also the default of `plexus mcp --transport stdio`); --tenant overrides it.
# PLEXUS_TENANT=
# Plexus MCP base URL the code hooks call; --url overrides it.
# PLEXUS_URL=http://127.0.0.1:8765

# --- Forgetting (activation ranking, docs/forgetting.md). Forgetting only lowers a fact's RANK in recall; nothing is deleted. ---
# on|off. off = recall is exactly the earlier retrieval order (recall(forgetting=...) overrides per call).
# PLEXUS_FORGETTING=on
# Power-law decay exponent d of A(f) = ln(sum w * t^-d), in (0, 2].
# PLEXUS_ACT_DECAY=0.5
# Neutral activation A0 (the ranking multiplier is half way between the floor and 1 there). Default: the activation of a
# fact created once, one day ago (about -5.68 at d=0.5).
# PLEXUS_ACT_A0=
# Lowest ranking multiplier, 0..1 (a faint fact is never scaled below this). Default 0.9: a floor of 0.5 let popular
# near-twin facts outrank the relevant one in Crucible L5b (recall@5 98.6% -> 73-75%, 7-8 of 80 critical probes lost).
# PLEXUS_ACT_FLOOR=0.9
# K: the newest events counted per fact, 1..200.
# PLEXUS_ACT_EVENTS=50

# --- Compose host ports (all optional). On the dev machine 6379/3000 belong to falkordb-dev: override them and use
# `docker compose -p <project>`. ---
# FALKORDB_PORT=6379
# FALKORDB_BROWSER_PORT=3000
# PLEXUS_API_PORT=8080
# PLEXUS_MCP_PORT=8765
# PLEXUS_VIEW_PORT=5180   # the View (also an allowed CORS origin of the API; changing it needs `docker compose up -d --build`)
# Image tags (set these when a second stack must not replace the images of the first):
# PLEXUS_IMAGE=plexus:dev
# PLEXUS_VIEW_IMAGE=plexus-view:dev
