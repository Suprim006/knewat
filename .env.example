# Copy to .env (git-ignored). Every variable Plexus reads is listed here.

# --- FalkorDB connection (used by plexus/ and tests) ---
# 127.0.0.1 avoids a ~2 s IPv6 (::1) fallback per connection on Windows + Docker Desktop.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
# Leave empty for no auth (local dev). Set when deploying publicly.
FALKORDB_PASSWORD=

# --- Tests (give each agent/suite its own container: scripts/agent_db.sh <slot>) ---
# Pass inline (PLEXUS_TEST_DB_PORT=6310 uv run pytest), do not export.
PLEXUS_TEST_DB_PORT=6310

# --- Compose host ports (all optional). On the dev machine 6379/3000 belong to falkordb-dev: override them and use
# `docker compose -p <project>`. ---
# FALKORDB_PORT=6379
# FALKORDB_BROWSER_PORT=3000
# PLEXUS_API_PORT=8080
# PLEXUS_MCP_PORT=8765
# PLEXUS_VIEW_PORT=5180   # the View (also an allowed CORS origin of the API; changing it needs `docker compose up -d --build`)
# Image tags (set these when a second stack must not replace the images of the first):
# PLEXUS_IMAGE=plexus:dev
# PLEXUS_VIEW_IMAGE=plexus-view:dev
